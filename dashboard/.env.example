# Firebase Client SDK (for browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Firebase Admin SDK (for server-side API routes)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email Notifications (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=AT Agent <notifications@yourdomain.com>

# App URL (REQUIRED for production - used in email links and notifications)
# Set this to your deployed dashboard URL (e.g., https://at-agent-dashboard.fly.dev)
# Falls back to http://localhost:3000 in development if not set
NEXT_PUBLIC_APP_URL=https://your-dashboard.example.com

# Cron Job Security
CRON_SECRET=your-random-secret-for-cron-auth
