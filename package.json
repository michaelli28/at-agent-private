{
  "name": "accessibility-driver-framework",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "browser",
    "drivers",
    "agent",
    "evaluation",
    "ui"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "dev:sr": "ts-node --transpile-only -r tsconfig-paths/register scripts/runScreenReaderDev.ts",
    "test:regression": "ts-node --transpile-only -r tsconfig-paths/register scripts/runRegression.ts",
    "start:agent": "ts-node --transpile-only -r tsconfig-paths/register scripts/runAgent.ts",
    "start:agent-parallel": "ts-node --transpile-only -r tsconfig-paths/register scripts/runAgentParallel.ts",
    "start:agent-experiment": "ts-node --transpile-only -r tsconfig-paths/register scripts/runAgentExperiment.ts",
    "start:agent-experiment-parallel": "ts-node --transpile-only -r tsconfig-paths/register scripts/runAgentExperimentParallel.ts",
    "start:agent-openrouter": "ts-node --transpile-only -r tsconfig-paths/register scripts/runAgentOpenrouter.ts",
    "start:agent-openrouter-parallel": "ts-node --transpile-only -r tsconfig-paths/register scripts/runAgentOpenrouterParallel.ts",
    "benchmark:aria-at": "ts-node --transpile-only -r tsconfig-paths/register scripts/benchmarkAriaAt.ts",
    "audit-dom": "ts-node --transpile-only -r tsconfig-paths/register scripts/auditDOM.ts",
    "audit-visual": "ts-node --transpile-only -r tsconfig-paths/register scripts/auditVisual.ts",
    "test:visual-regression": "ts-node --transpile-only -r tsconfig-paths/register scripts/auditVisualRegression.ts",
    "audit-visual-regression": "ts-node --transpile-only -r tsconfig-paths/register scripts/auditVisualRegression.ts",
    "audit-media": "ts-node --transpile-only -r tsconfig-paths/register scripts/auditMedia.ts",
    "audit": "ts-node --transpile-only -r tsconfig-paths/register scripts/runAudit.ts",
    "test-media": "ts-node --transpile-only -r tsconfig-paths/register scripts/testMediaLLM.ts",
    "test-browser": "ts-node --transpile-only scripts/testBrowserClient.ts",
    "visualize-report": "ts-node --transpile-only -r tsconfig-paths/register scripts/generateReportHtml.ts",
    "generate-graph": "ts-node --transpile-only scripts/generateGraphML.ts",
    "generate-sitemap": "ts-node --transpile-only scripts/generateSitemap.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "puppeteer": "^24.31.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.0.6",
    "@langchain/google-genai": "^2.0.0",
    "@langchain/langgraph": "^1.0.2",
    "@langchain/openai": "^1.1.3",
    "axe-core": "^4.11.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "jsonrepair": "^3.13.1",
    "langchain": "^1.0.6",
    "openai": "^6.9.1",
    "ora": "^9.0.0",
    "tiktoken": "^1.0.22"
  }
}
