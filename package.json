{
  "name": "accessibility-driver-framework",
  "version": "0.0.1",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer",
      "playwright",
      "@playwright/test"
    ]
  },
  "workspaces": [

    "packages/browser",
    "packages/shared",
    "packages/drivers",
    "packages/evaluation",
    "apps/agent",
    "apps/dashboard",
    "apps/ui",
    "apps/virtual-screen-reader",
    "services/rerun-worker",
    "browser",
    "drivers",
    "agent",
    "evaluation",
    "ui",
    "virtual-screen-reader",
    "taskgen"

  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:cli": "esbuild scripts/runAgentCli.ts --bundle --platform=node --target=node20 --outfile=dist/runAgentCli.js --external:playwright --external:@langchain/* --external:langchain --external:openai --external:dotenv --external:tiktoken",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "dev:sr": "tsx -r tsconfig-paths/register scripts/runScreenReaderDev.ts",
    "test:regression": "tsx -r tsconfig-paths/register scripts/runRegression.ts",
    "start:agent": "tsx -r tsconfig-paths/register scripts/runAgent.ts",
    "start:agent-cli": "tsx -r tsconfig-paths/register scripts/runAgentCli.ts",
    "start:agent-parallel": "tsx -r tsconfig-paths/register scripts/runAgentParallel.ts",
    "start:agent-experiment": "tsx -r tsconfig-paths/register scripts/runAgentExperiment.ts",
    "start:agent-experiment-parallel": "tsx -r tsconfig-paths/register scripts/runAgentExperimentParallel.ts",
    "start:agent-openrouter": "tsx -r tsconfig-paths/register scripts/runAgentOpenrouter.ts",
    "start:agent-openrouter-parallel": "tsx -r tsconfig-paths/register scripts/runAgentOpenrouterParallel.ts",
    "benchmark:aria-at": "tsx -r tsconfig-paths/register scripts/benchmarkAriaAt.ts",
    "audit-dom": "tsx -r tsconfig-paths/register scripts/auditDOM.ts",
    "audit-visual": "tsx -r tsconfig-paths/register scripts/auditVisual.ts",
    "test:visual-regression": "tsx -r tsconfig-paths/register scripts/auditVisualRegression.ts",
    "audit-visual-regression": "tsx -r tsconfig-paths/register scripts/auditVisualRegression.ts",
    "audit-media": "tsx -r tsconfig-paths/register scripts/auditMedia.ts",
    "audit": "tsx -r tsconfig-paths/register scripts/runAudit.ts",
    "test-media": "tsx -r tsconfig-paths/register scripts/testMediaLLM.ts",
    "test-browser": "tsx scripts/testBrowserClient.ts",
    "visualize-report": "tsx -r tsconfig-paths/register scripts/generateReportHtml.ts",
    "generate-graph": "tsx scripts/generateGraphML.ts",
    "generate-sitemap": "tsx scripts/generateSitemap.ts",

    "start:ui": "tsx -r tsconfig-paths/register apps/ui/server.ts",
    "start:debug-ui": "tsx -r tsconfig-paths/register apps/ui/debug-server.ts",
    "taskgen": "tsx -r tsconfig-paths/register taskgen/src/cli.ts",
    "taskgen:detailed": "tsx -r tsconfig-paths/register taskgen/src/cli.ts --detailed",
    "taskgen:run": "tsx -r tsconfig-paths/register scripts/runTaskgenTests.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "esbuild": "^0.27.1",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "puppeteer": "^24.31.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.0.6",
    "@langchain/google-genai": "^2.0.0",
    "@langchain/langgraph": "^1.0.2",
    "@langchain/openai": "^1.1.3",
    "@playwright/test": "^1.57.0",
    "@types/express": "^4.17.0",
    "@types/ws": "^8.5.0",
    "axe-core": "^4.11.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "dom-accessibility-api": "^0.7.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.0",
    "firebase-admin": "^12.0.0",
    "jsonrepair": "^3.13.1",
    "langchain": "^1.0.6",
    "openai": "^6.9.1",
    "ora": "^9.0.0",
    "playwright": "^1.57.0",
    "tiktoken": "^1.0.22",
    "ws": "^8.14.0",
    "zod": "^3.23.8"
  }
}
