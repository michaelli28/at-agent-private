package(default_visibility = ["//visibility:public"])

# Next.js app - build with pnpm directly
# bazel build not recommended for Next.js apps

filegroup(
    name = "sources",
    srcs = glob([
        "src/**/*",
        "public/**/*",
    ]),
)

filegroup(
    name = "configs",
    srcs = [
        "next.config.js",
        "package.json",
        "tsconfig.json",
    ],
)
