load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")

# Root tsconfig for the monorepo
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//visibility:public"],
)

# Expose package.json for workspace info
exports_files([
    "package.json",
    "pnpm-lock.yaml",
    "tsconfig.json",
    ".bazelignore",
])

# Filegroup for shared config files
filegroup(
    name = "root_configs",
    srcs = [
        "package.json",
        "tsconfig.json",
    ],
    visibility = ["//visibility:public"],
)
