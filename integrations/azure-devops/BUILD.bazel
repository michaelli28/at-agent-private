package(default_visibility = ["//visibility:public"])

# Azure DevOps extension - build with tfx-cli directly
# Run: cd integrations/azure-devops && npx tfx extension create

filegroup(
    name = "sources",
    srcs = glob(
        ["tasks/**/*"],
        allow_empty = True,
    ),
)

filegroup(
    name = "config",
    srcs = [
        "vss-extension.json",
        "package.json",
    ],
)
