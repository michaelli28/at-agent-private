package(default_visibility = ["//visibility:public"])

# GitLab CI template files
filegroup(
    name = "templates",
    srcs = [".gitlab-ci-template.yml"],
)

# Example configurations
filegroup(
    name = "examples",
    srcs = glob(
        ["examples/**/*"],
        allow_empty = True,
    ),
)

# Scripts
filegroup(
    name = "scripts",
    srcs = ["entrypoint.sh"],
)

# Documentation
filegroup(
    name = "docs",
    srcs = [
        "README.md",
        "Dockerfile",
    ],
)
